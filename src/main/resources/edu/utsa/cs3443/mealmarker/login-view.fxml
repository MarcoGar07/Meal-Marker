<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600" prefWidth="900" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.mealmarker.LoginController">

    <children>
        <VBox alignment="CENTER" prefWidth="380" spacing="18" AnchorPane.leftAnchor="260" AnchorPane.topAnchor="100">

            <padding>
                <Insets bottom="30" left="35" right="35" top="30" />
            </padding>

            <Label style="-fx-font-size: 30px; -fx-font-weight: bold;" text="MEAL MAKER" />

            <Label style="-fx-font-size: 14px;" text="Your meals. Your budget. Your plan." />

            <TextField fx:id="usernameTextField" prefHeight="40" promptText="Username" />

            <PasswordField fx:id="passwordTextField" prefHeight="40" promptText="Password" />

            <Button fx:id="loginButton" maxWidth="Infinity" onAction="#login" prefHeight="40" text="Login" />

            <HBox alignment="CENTER" spacing="10">
                <Button fx:id="createAccountButton" onAction="#createAccount" text="Create Account" />

                <Button onAction="#forgotPassword" text="Forgot Password?" />
            </HBox>

        </VBox>
    </children>
</AnchorPane>
